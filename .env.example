# Supabase Postgres connection string (Project Settings > Database > Connection string > URI).
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Supabase project API settings (Project Settings > API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# FatSecret Platform API (https://platform.fatsecret.com) — the source of the
# calorie, protein and fat figures. Optional: with these unset the app falls
# back to estimating calories from the ingredient lines, and shows no macros.
# Note that FatSecret only accepts token requests from the IP addresses
# registered against the key — see the README.
FATSECRET_CLIENT_ID=your-client-id
FATSECRET_CLIENT_SECRET=your-client-secret

# Which of FatSecret's food databases to search. Defaults to Danish, which is
# what the app is — override only for a key provisioned for somewhere else.
# Needs the `localization` scope; a key without it is detected and downgraded
# to the English database automatically.
# FATSECRET_REGION=DK
# FATSECRET_LANGUAGE=da

# Optional: route the token/API requests through a proxy with a stable IP, for
# the allowlist above.
# FATSECRET_TOKEN_URL=https://your-proxy.example.com/connect/token
# FATSECRET_API_URL=https://your-proxy.example.com/rest/server.api
